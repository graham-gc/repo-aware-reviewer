{
  "type": "object",
  "additionalProperties": false,
  "required": ["route", "summary", "decisions"],
  "properties": {
    "route": {"type": "string", "enum": ["LOCAL", "DEEP"]},
    "summary": {"type": "string"},
    "decisions": {
      "type": "array",
      "items": {"anyOf": [{"$ref": "#/$defs/confirmed"}, {"$ref": "#/$defs/unresolved"}]}
    }
  },
  "$defs": {
    "confirmed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "relation", "baseline", "contract", "support", "premises", "finding"],
      "properties": {
        "status": {"type": "string", "enum": ["CONFIRMED"]},
        "reason": {"type": "string"},
        "relation": {"type": "string", "enum": ["INTRODUCED", "EXPOSED_BY_CHANGE"]},
        "baseline": {"type": "string"},
        "contract": {"type": "string"},
        "support": {"type": "string", "enum": ["REACHABLE_FAILURE"]},
        "premises": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/premise"}},
        "citations": {"$ref": "#/$defs/citations"},
        "finding": {"allOf": [{"$ref": "#/$defs/finding"}, {"type": "object", "required": ["severity"]}]}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "finding"],
      "properties": {
        "status": {"type": "string", "enum": ["INSUFFICIENT_EVIDENCE"]},
        "reason": {"type": "string"},
        "contract": {"type": "string"},
        "citations": {"$ref": "#/$defs/citations"},
        "finding": {"$ref": "#/$defs/finding"},
        "nextCheck": {"type": "string"},
        "requests": {"type": "array", "items": {"type": "string"}}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "path", "line", "endLine", "trigger", "impact", "evidence", "diffRelation"],
      "properties": {
        "title": {"type": "string"},
        "severity": {"type": "string", "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"]},
        "path": {"type": "string"},
        "line": {"type": "integer"},
        "endLine": {"type": "integer"},
        "trigger": {"type": "string"},
        "impact": {"type": "string"},
        "evidence": {"type": "string"},
        "diffRelation": {"type": "string"}
      }
    },
    "premise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "basis", "citations"],
      "properties": {
        "statement": {"type": "string"},
        "basis": {"type": "string", "enum": ["IMPLEMENTATION", "OUTCOME", "SEVERITY"]},
        "citations": {"$ref": "#/$defs/citations"}
      }
    },
    "citations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "lines"],
        "properties": {
          "source": {"type": "string"},
          "lines": {"type": "string"}
        }
      }
    }
  }
}
